# ─────────────────────────────────────────────────────────────────────────────
# PITCHMARKET configuration. Copy to `.env` for local development.
# Placeholders only — never commit real secrets. All values are server-side;
# nothing here is exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, RDS, local…). Required.
# For Neon/Supabase use the *pooled* connection string and add ?sslmode=require.
DATABASE_URL=postgres://pitchmarket:pitchmarket@localhost:5432/pitchmarket

# Public base URL (used in invite links and password-reset emails).
APP_URL=http://localhost:3000

# Product name shown everywhere (wordmark, titles, emails).
APP_NAME=PITCHMARKET

# `production` for a real competition; `demo` shows a demo banner, allows the
# self-service portfolio reset and demo accounts (`npm run demo:users`).
APP_MODE=production

# ── Game economy ────────────────────────────────────────────────────────────
STARTING_BALANCE_CREDITS=100000
# Trading fee in basis points (25 = 0.25%). 0 = no fee.
TRADING_FEE_BPS=0
MAX_SHARES_PER_ORDER=5000
# `halt` locks trading in a player while their match is live (recommended:
# match data reaches us after TV, so in-play trading would reward latency).
LIVE_TRADING_POLICY=halt
# Auto-halt the whole market if a live match has no fresh data for this long.
STALE_LIVE_DATA_HALT_MINUTES=15

# ── Football data ───────────────────────────────────────────────────────────
# auto        = live FPL API if reachable, otherwise the public GitHub snapshot
# fpl         = live FPL API only
# fpl-archive = public GitHub snapshot only (delayed by days)
DATA_PROVIDER=auto
FPL_SEASON=2026-27
LIVE_POLL_SECONDS=60
# FPL_BASE_URL=https://fantasy.premierleague.com/api
# FPL_ARCHIVE_BASE_URL=https://raw.githubusercontent.com/vaastav/Fantasy-Premier-League/master/data
# FPL_ARCHIVE_LOCAL_DIR=          # optional: read archive CSVs from disk (offline)

# Optional: fixtures/results for other competitions (free key at football-data.org).
# Free tier has no player stats, so these competitions are results-only.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITIONS=PD,BL1,SA,FL1,CL

# ── Operations & security ───────────────────────────────────────────────────
# Secret for the scheduler endpoint (GET /api/cron/tick with
# `Authorization: Bearer $CRON_SECRET`). Generate: openssl rand -hex 32
CRON_SECRET=
# Send password-reset emails via Resend (https://resend.com). Without it, links
# are printed to the dev server console in development only.
RESEND_API_KEY=
EMAIL_FROM=PITCHMARKET <no-reply@your-domain.example>
SESSION_TTL_DAYS=30
# Defaults to true in production. Set false only for plain-http local testing.
# SECURE_COOKIES=true
LOG_LEVEL=info
# DB_POOL_MAX=10
